#!/usr/bin/env bash
set -euo pipefail

# Reload direnv when core environment inputs change.
watch_file .env
watch_file mise.toml

# Basic tooling checks used by local workflows.
if ! command -v mise >/dev/null 2>&1; then
  echo "direnv: mise is required but was not found in PATH" >&2
  exit 1
fi

# Puts the tools pinned in mise.toml on PATH for this directory.
eval "$(mise env -s bash)"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "direnv: pnpm is required but was not found in PATH" >&2
  exit 1
fi

# Load local environment variables when present.
if [[ -f .env ]]; then
  dotenv .env
fi
