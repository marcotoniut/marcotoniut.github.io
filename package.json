{
  "name": "marcotoniut.github.io",
  "private": true,
  "scripts": {
    "audit": "pnpm audit --audit-level=high",
    "build": "pnpm generate:sitemap && next build",
    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm spellcheck && pnpm test && pnpm build",
    "check:agent": "./scripts/check-agent.sh --json",
    "deploy": "echo \"Deploy by pushing the release branch\"",
    "dev": "pnpm generate && concurrently \"pnpm generate:watch\" \"next dev -p 8525\"",
    "dev:agents": "pnpm generate && cross-env BROWSER=none next dev -p 8530",
    "dev:pdf": "cross-env NEXT_PUBLIC_PDF_PRINTING=true concurrently \"sleep 3 && open-cli http://localhost:8528/en/cv\" \"next dev -p 8528\"",
    "dev:pdf:headless": "cross-env NEXT_PUBLIC_PDF_PRINTING=true next dev -p 8528",
    "discover": "pnpm tsx scripts/repo-discovery.ts",
    "format": "biome format",
    "format:check": "biome check",
    "generate": "pnpm typesafe-i18n",
    "generate:sitemap": "pnpm tsx scripts/generate-sitemap.ts",
    "generate:watch": "pnpm typesafe-i18n:watch",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:fix:unsafe": "biome check --write --unsafe",
    "print-cv": "pnpm tsx scripts/print-cv.ts",
    "spellcheck": "cspell lint .",
    "start": "next start",
    "test": "vitest run",
    "test:a11y": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/a11y.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts",
    "test:visual": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/visual.spec.ts --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "tsc --pretty --noEmit",
    "typesafe-i18n": "typesafe-i18n --no-watch",
    "typesafe-i18n:watch": "typesafe-i18n"
  },
  "dependencies": {
    "@next/third-parties": "16.3.4",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/recipes": "0.5.7",
    "date-fns": "4.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typesafe-i18n": "5.27.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@cspell/dict-en-gb": "5.0.31",
    "@cspell/dict-es-es": "3.0.8",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@vanilla-extract/next-plugin": "2.5.2",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "chokidar-cli": "3.0.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "cspell": "10.2.0",
    "happy-dom": "20.12.0",
    "open-cli": "9.0.0",
    "puppeteer": "25.9.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.1.1"
}
