{
  "name": "marcotoniut.github.io",
  "private": true,
  "scripts": {
    "build": "pnpm generate:sitemap && vike build",
    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm spellcheck && pnpm test && pnpm build",
    "check:agent": "node scripts/check-agent.mts",
    "check:react-compiler": "oxlint -c oxlint.react-compiler.json --deny-warnings src",
    "check:type-aware": "oxlint -c oxlint.type-aware.json --type-aware --deny-warnings .",
    "check:unused": "knip --no-progress",
    "dev": "pnpm generate && concurrently \"pnpm generate:watch\" \"vike dev --port 8525\"",
    "dev:agents": "pnpm generate && vike dev --port 8530",
    "dev:pdf": "cross-env PUBLIC_ENV__PDF_PRINTING=true concurrently \"sleep 3 && open-cli http://localhost:8528/en/cv/\" \"vike dev --port 8528\"",
    "dev:pdf:headless": "cross-env PUBLIC_ENV__PDF_PRINTING=true vike dev --port 8528",
    "discover": "node scripts/repo-discovery.ts",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate": "pnpm typesafe-i18n",
    "generate:sitemap": "node scripts/generate-sitemap.ts",
    "generate:watch": "pnpm typesafe-i18n:watch",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "lint": "pnpm lint:biome && pnpm check:react-compiler && pnpm check:type-aware && pnpm check:unused",
    "lint:biome": "biome check",
    "lint:fix": "biome check --write",
    "lint:fix:unsafe": "biome check --write --unsafe",
    "postinstall": "pnpm generate",
    "print-cv": "node scripts/print-cv.ts",
    "spellcheck": "cspell lint .",
    "start": "vike preview",
    "test": "vitest run",
    "test:a11y": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/a11y.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts --grep-invert @visual && pnpm test:visual",
    "test:visual": "bin/visual-docker.sh",
    "test:visual:update": "bin/visual-docker.sh --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "tsc --pretty --noEmit",
    "typesafe-i18n": "typesafe-i18n --no-watch",
    "typesafe-i18n:watch": "typesafe-i18n",
    "test:preferences": "playwright test -c tests/e2e/playwright.config.ts tests/e2e/preferences.spec.ts"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.3.3",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typesafe-i18n": "5.27.1",
    "vike": "0.4.270",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-en-gb": "5.0.31",
    "@cspell/dict-es-es": "3.0.8",
    "@playwright/test": "catalog:",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/sprinkles": "1.7.1",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "cspell": "10.2.0",
    "happy-dom": "21.0.4",
    "knip": "6.44.1",
    "open-cli": "9.0.0",
    "oxc-transform-react": "0.156.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "puppeteer": "25.17.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.17.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  }
}
