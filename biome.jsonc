{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*", "!.claude", "!public"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": { "formatter": { "selfCloseVoidElements": "always" } },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "all",
      "project": "all",
      "types": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "noGlobalDirnameFilename": "error",
        "useImportExtensions": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        // React's prop is `hrefLang`; the rule only knows the HTML spelling.
        "noUnknownAttribute": {
          "level": "error",
          "options": { "ignore": ["hrefLang"] }
        },
        "noDoubleEquals": {
          "level": "error",
          "options": { "ignoreNull": false }
        },
        "noConstantBinaryExpressions": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useErrorMessage": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "complexity": {
        "noUselessCatch": "error",
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": {
        "useConst": "error",
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useThrowOnlyError": "error",
        "useNamingConvention": "off",
        "useDefaultParameterLast": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noNestedTernary": "off",
        "noEnum": "error"
      },
      "security": {
        "noSecrets": "off"
      },
      "performance": {
        "noDelete": "error",
        // `reactCompiler` in next.config.mts memoizes inline handlers, so
        // hand-written useCallback wrappers would be noise.
        "noJsxPropsBind": "off"
      }
    }
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "useImportExtensions": "error" }
        }
      }
    },
    {
      // `@playwright/test` only does `export * from "playwright/test"`, which
      // Biome's resolver does not follow, so every named import reads as
      // unresolved.
      "includes": [
        "tests/e2e/**",
        "scripts/generate-og.ts",
        "scripts/generate-icons.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.{js,jsx,ts,tsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          },
          "style": {
            "noProcessEnv": "error",
            "useFilenamingConvention": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.css.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      // Vike fixes the names of its `+` files.
      "includes": ["src/pages/**/+*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/theme-provider.tsx",
        "src/renderer/page-context.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/env.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
